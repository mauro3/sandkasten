#!/bin/bash
#
# Run development environment in sandbox by spawning a wezterm session. Tools include:
# - Julia lang
# - Helix editor
# - aider AI coder

# Parse arguments
WITH_JULIA=true
PROJECT_ROOT=""

while [[ $# -gt 0 ]]; do
    case $1 in
        --no-julia)
            WITH_JULIA=false
            shift
            ;;
        -*)
            echo "Unknown option $1"
            echo "Usage: $0 [--no-julia] [project_directory]"
            exit 1
            ;;
        *)
            PROJECT_ROOT="$1"
            shift
            ;;
    esac
done

# Project directory from argument or current directory
PROJECT_ROOT=$(realpath "${PROJECT_ROOT:-$(pwd)}")
echo "Setting up sandbox for: $PROJECT_ROOT"
if [ "$WITH_JULIA" = true ]; then
    echo "Julia support enabled"
else
    echo "Julia support disabled (use without --no-julia to enable)"
fi

# Ensure the project directory exists
mkdir -p "$PROJECT_ROOT"

# Create sandbox directory in cache with date and random string
CACHE_DIR="$HOME/.cache/sandkasten"
mkdir -p "$CACHE_DIR"
RANDOM_SUFFIX=$(openssl rand -hex 4)  # 8-character hex string
SANDBOX_HOME="$CACHE_DIR/$(date +%Y-%m-%d)_$RANDOM_SUFFIX"
mkdir -p "$SANDBOX_HOME"
echo "Sandbox home: $SANDBOX_HOME"

# Set up minimal configuration directories
mkdir -p "$SANDBOX_HOME/.config/fish"
mkdir -p "$SANDBOX_HOME/.config/wezterm"
mkdir -p "$SANDBOX_HOME/.config/helix"
mkdir -p "$SANDBOX_HOME/.local/share/fish"
mkdir -p "$SANDBOX_HOME/.cargo/bin/"
mkdir -p "$SANDBOX_HOME/bin"

# Copy essential configuration files
[ -f "$HOME/.config/fish/config.fish" ] && cp "$HOME/.config/fish/config.fish" "$SANDBOX_HOME/.config/fish/"
[ -f "$HOME/.config/wezterm/wezterm.lua" ] && cp "$HOME/.config/wezterm/wezterm.lua" "$SANDBOX_HOME/.config/wezterm/"
[ -f "$HOME/.config/helix/config.toml" ] && cp "$HOME/.config/helix/config.toml" "$SANDBOX_HOME/.config/helix/"
[ -f "$HOME/.config/helix/languages.toml" ] && cp "$HOME/.config/helix/languages.toml" "$SANDBOX_HOME/.config/helix/"
[ -f "$HOME/.gitignore.global" ] && cp "$HOME/.gitignore.global" "$SANDBOX_HOME"
[ -f "$HOME/.aider.conf.yml" ] && cp "$HOME/.aider.conf.yml" "$SANDBOX_HOME"
[ -f "$HOME/.gitconfig" ] && cp "$HOME/.gitconfig" "$SANDBOX_HOME"
# copy configuration folders
# [ -d "$HOME/.config/meld" ] && cp -r "$HOME/.config/meld" "$SANDBOX_HOME/.config/"
[ -d "$HOME/.aider" ] && cp -r "$HOME/.aider" "$SANDBOX_HOME"
# copy needed shell scripts
[ -f "$HOME/bin/juliap" ] && cp "$HOME/bin/juliap" "$SANDBOX_HOME/bin/"
[ -f "$HOME/bin/helix-repl-start.sh" ] && cp "$HOME/bin/helix-repl-start.sh" "$SANDBOX_HOME/bin/"
[ -f "$HOME/bin/vale-ls" ] && cp "$HOME/bin/vale-ls" "$SANDBOX_HOME/bin/"
[ -f "$HOME/.cargo/bin/simple-completion-language-server" ] && cp "$HOME/.cargo/bin/simple-completion-language-server" "$SANDBOX_HOME/.cargo/bin/simple-completion-language-server"

# Larger directories are copyed on write (COW), if possible
COW_BINDS=""
# Julia-related directories (only if requested)
if [ "$WITH_JULIA" = true ]; then
    # Create Julia depot snapshot/copy
    JULIA_DEPOT_SANDBOX="$SANDBOX_HOME/.julia"
    if [ -d "$HOME/.julia" ]; then
        echo "Creating Julia depot snapshot..."
        if btrfs subvolume snapshot "$HOME/.julia" "$JULIA_DEPOT_SANDBOX" 2>/dev/null; then
            echo "BTRFS snapshot created successfully"
        else
            echo "BTRFS snapshot failed, copying with COW if available..."
            cp -r "$HOME/.julia" "$JULIA_DEPOT_SANDBOX"
        fi
    else
        mkdir -p "$JULIA_DEPOT_SANDBOX"
    fi

    # Create Juliaup directory snapshot/copy
    JULIAUP_SANDBOX="$SANDBOX_HOME/.juliaup"
    if [ -d "$HOME/.juliaup" ]; then
        echo "Creating .juliaup snapshot..."
        if btrfs subvolume snapshot "$HOME/.juliaup" "$JULIAUP_SANDBOX" 2>/dev/null; then
            echo "BTRFS snapshot created successfully"
        else
            echo "BTRFS snapshot failed, copying with COW if available..."
            cp -r "$HOME/.juliaup" "$JULIAUP_SANDBOX"
        fi
    else
        mkdir -p "$JULIAUP_SANDBOX"
    fi
    COW_BINDS="--bind $JULIA_DEPOT_SANDBOX /home/$USERNAME/.julia --bind $JULIAUP_SANDBOX /home/$USERNAME/.juliaup"
fi
# Create Tectonic cache directory snapshot/copy
TECTONIC_CACHE_SANDBOX="$SANDBOX_HOME/.cache/Tectonic"
if [ -d "$HOME/.cache/Tectonic" ]; then
    echo "Creating Tectonic cache snapshot..."
    mkdir -p "$SANDBOX_HOME/.cache"
    if btrfs subvolume snapshot "$HOME/.cache/Tectonic" "$TECTONIC_CACHE_SANDBOX" 2>/dev/null; then
        echo "BTRFS snapshot created successfully"
    else
        echo "BTRFS snapshot failed, copying with COW if available..."
        cp -r "$HOME/.cache/Tectonic" "$TECTONIC_CACHE_SANDBOX"
    fi
else
    mkdir -p "$TECTONIC_CACHE_SANDBOX"
fi
COW_BINDS="$COW_BINDS --bind $TECTONIC_CACHE_SANDBOX /home/$USERNAME/.cache/Tectonic"



# Patch wezterm.lua to uncomment sandbox-specific settings
if [ -f "$SANDBOX_HOME/.config/wezterm/wezterm.lua" ]; then
  sed -i 's/-- config.use_fancy_tab_bar = false/config.use_fancy_tab_bar = false/' "$SANDBOX_HOME/.config/wezterm/wezterm.lua"
  sed -i 's/-- config.colors.tab_bar = { background = "#9C923C" }/config.colors.tab_bar = { background = "#9C923C" }/' "$SANDBOX_HOME/.config/wezterm/wezterm.lua"
fi

# Create sandbox-specific fish configuration
cat > "$SANDBOX_HOME/.config/fish/sandbox.fish" <<EOF
# Sandbox-specific Fish configuration
function fish_prompt
    set_color yellow
    echo -n "[SANDBOX] "
    set_color cyan
    echo -n (prompt_pwd)
    set_color normal
    echo -n "> "
end

set -x EDITOR hx
set -x OPENAI_API_KEY "$OPENAI_API_KEY"
set -x ANTHROPIC_API_KEY "$ANTHROPIC_API_KEY"

# Graphics configuration for Julia
set -x LIBGL_ALWAYS_SOFTWARE "1"


# Welcome message
echo "🔒 Sandboxed Environment: $PROJECT_ROOT 🔒"
EOF

# Append sandbox config to config.fish
echo "source ~/.config/fish/sandbox.fish" >> "$SANDBOX_HOME/.config/fish/config.fish"

# Terminal launcher script
cat > "$SANDBOX_HOME/terminal.sh" <<EOF
#!/bin/bash
cd "$PROJECT_ROOT" || echo "Failed to change to project directory: \$?"
exec fish
EOF
chmod +x "$SANDBOX_HOME/terminal.sh"

# Create a temp directory (i.e. /tmp) that will persist during the sandbox session
WEZTERM_TEMP=$(mktemp -d)
echo "WezTerm temp: $WEZTERM_TEMP"

# Get user name
USERNAME=$(whoami)

# Get path to aider
AIDER_PATH=$(which aider || echo "")

# Tool binds - only add aider as requested
TOOL_BINDS=""
if [ -n "$AIDER_PATH" ]; then
    TOOL_BINDS="$TOOL_BINDS --ro-bind $AIDER_PATH $AIDER_PATH"
    # Add UV directory for aider
    if [ -d "$HOME/.local/share/uv" ]; then
        TOOL_BINDS="$TOOL_BINDS --ro-bind $HOME/.local/share/uv $HOME/.local/share/uv"
    fi
fi

# Display server configuration
DISPLAY_BINDS=""
# Wayland
DISPLAY_BINDS="--ro-bind $XDG_RUNTIME_DIR/$WAYLAND_DISPLAY $XDG_RUNTIME_DIR/$WAYLAND_DISPLAY"
if [ -e "$XDG_RUNTIME_DIR/bus" ]; then
  DISPLAY_BINDS="$DISPLAY_BINDS --bind $XDG_RUNTIME_DIR/bus $XDG_RUNTIME_DIR/bus"
fi

# Add DRI access permissions
GPU_BINDS=""
for dev in /dev/dri/renderD* /dev/dri/card*; do
  if [ -e "$dev" ]; then
    echo "Binding DRI device: $dev"
    GPU_BINDS="$GPU_BINDS --dev-bind $dev $dev"
  fi
done

# Launch sandbox
echo "Launching sandboxed WezTerm..."

# Execute bwrap without variable expansion in the command string
# note that the order of binds is important
bwrap --unshare-user-try --unshare-pid --unshare-uts --unshare-cgroup \
      --ro-bind /usr /usr \
      --ro-bind /bin /bin \
      --ro-bind /lib /lib \
      --ro-bind /lib64 /lib64 \
      --ro-bind /usr/share/fonts /usr/share/fonts \
      --ro-bind /etc/ssl /etc/ssl \
      --ro-bind /etc/fonts /etc/fonts \
      --ro-bind /etc/resolv.conf /etc/resolv.conf \
      --ro-bind /etc/hosts /etc/hosts \
      --ro-bind /etc/hostname /etc/hostname \
      --share-net \
      --dev-bind /dev/null /dev/null \
      --dev-bind /dev/zero /dev/zero \
      --dev-bind /dev/full /dev/full \
      --dev-bind /dev/random /dev/random \
      --dev-bind /dev/urandom /dev/urandom \
      --dev-bind /dev/tty /dev/tty \
      --tmpfs /dev/pts \
      --dev-bind /dev/ptmx /dev/ptmx \
      --symlink /proc/self/fd/0 /dev/stdin \
      --symlink /proc/self/fd/1 /dev/stdout \
      --symlink /proc/self/fd/2 /dev/stderr \
      --symlink /proc/self/fd /dev/fd \
      --tmpfs /dev/shm \
      --tmpfs /dev/shm \
      $GPU_BINDS \
      --bind "$WEZTERM_TEMP" /tmp \
      $DISPLAY_BINDS \
      --proc /proc \
      --bind "$SANDBOX_HOME" "/home/$USERNAME" \
      $COW_BINDS \
      $TOOL_BINDS \
      --bind "$PROJECT_ROOT" "$PROJECT_ROOT" \
      --setenv HOME "/home/$USERNAME" \
      --setenv WAYLAND_DISPLAY "$WAYLAND_DISPLAY" \
      --setenv XDG_RUNTIME_DIR "$XDG_RUNTIME_DIR" \
      --setenv DBUS_SESSION_BUS_ADDRESS "unix:path=$XDG_RUNTIME_DIR/bus" \
      --setenv PATH "/usr/local/bin:/usr/bin:/bin:/home/$USERNAME/.local/bin:/home/$USERNAME/.juliaup/bin:/home/$USERNAME/bin" \
      --setenv OPENAI_API_KEY "$OPENAI_API_KEY" \
      --setenv OPENAI_API_BASE "$OPENAI_API_BASE" \
      --setenv ANTHROPIC_API_KEY "$ANTHROPIC_API_KEY" \
      --setenv TMPDIR "/tmp" \
      /usr/bin/wezterm start --cwd "$PROJECT_ROOT"

# Capture the exit code
BWRAP_EXIT=$?
echo "bwrap exited with code: $BWRAP_EXIT"

# Clean up
read -p "Delete sandbox directory $SANDBOX_HOME and temp $WEZTERM_TEMP? (y/N)" -n 1 -r
echo    # move to a new line
if [[ $REPLY =~ ^[Yy]$ ]]; then
   # Try to delete BTRFS subvolumes first for faster cleanup
   for subvol in "$JULIA_DEPOT_SANDBOX" "$JULIAUP_SANDBOX" "$TECTONIC_CACHE_SANDBOX"; do
       if [ -d "$subvol" ]; then
           echo "Trying to delete BTRFS subvolume: $subvol"
           if btrfs subvolume delete "$subvol" 2>/dev/null; then
               echo "Successfully deleted subvolume: $subvol"
           fi
       fi
   done
   
   # Remove the entire sandbox directory (handles any remaining files/dirs)
   rm -rf "$SANDBOX_HOME"
   rm -rf "$WEZTERM_TEMP"
fi
