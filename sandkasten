def make_parser():
    """Return the headless option parser (the desktop launcher extends it)."""
    parser = argparse.ArgumentParser(
        description=__doc__,
        epilog=(
            "Restarting in the same project reuses its saved home. "
            "Homes, including those created with --fresh, are retained after exit; "
            "--tmp homes are deleted. "
            "Remove a saved home with sandkasten-cleanup SANDBOX_HOME_NAME, or remove all "
            "inactive homes with sandkasten-cleanup. Deleting the project's saved "
            "home resets its state for the next launch."
        ),
    )
    parser.add_argument("project", nargs="?", default=".", help="writable project directory")
    parser.add_argument(
        "--no-julia", dest="julia", action="store_false",
        help="skip default Julia copies and Juliaup PATH setup; keep existing saved files",
    )
    parser.add_argument(
        "--no-host-config", dest="host_config", action="store_false",
        help="skip default shell, Git, Helix and Pi config copies (including Pi auth); keep existing saved files",
    )
    parser.add_argument(
        "-c", "--copy", action="append", default=[], metavar="PATH",
        help="copy a file/directory from inside your home, preserving its home-relative path (repeatable)",
    )
    parser.add_argument(
        "--host-net", action="store_true",
        help="share the host network, including LAN and localhost "
             "(default: private network via pasta, internet only)",
    )
    parser.add_argument(
        "--dry-run", action="store_true",
        help="print the planned command without creating/copying files or launching; redact API keys",
    )
    parser.add_argument(
        "--fresh", action="store_true",
        help="use a separate one-off home instead of the project's saved one (also retained until sandkasten-cleanup)",
    )
    parser.add_argument(
        "--tmp", action="store_true",
        help="like --fresh, but delete the home when the session ends",
    )
    return parser

if __name__ == "__main__":
    try:
        sys.exit(launch(make_parser().parse_args()))
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        print(f"sandkasten: {error}", file=sys.stderr)
        sys.exit(1)
