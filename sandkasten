#!/bin/bash
#
# Run development environment in sandbox by spawning a wezterm session. Tools include:
# - Julia lang
# - Helix editor
# - opencode AI-agentic coder

# === HELPER FUNCTIONS ===

create_cow_snapshot() {
    local SOURCE_DIR="$1"
    local DEST_DIR="$2"
    
    if [ -d "$SOURCE_DIR" ]; then
        echo "Creating snapshot: $SOURCE_DIR" >&2
        if btrfs -q subvolume snapshot "$SOURCE_DIR" "$DEST_DIR" 2>/dev/null; then
            echo "BTRFS snapshot created successfully" >&2
        else
            echo "BTRFS snapshot failed, copying with COW if available..." >&2
            cp -r "$SOURCE_DIR" "$DEST_DIR"
        fi
    else
        mkdir -p "$DEST_DIR"
    fi
    
    # Echo the snapshot path
    echo "$DEST_DIR"
}

# === MAIN SCRIPT ===

## Locate repository-managed resources independently of the current project
SCRIPT_DIR=$(dirname "$(realpath "${BASH_SOURCE[0]}")")
NIX_TOOLS_PROFILE="$SCRIPT_DIR/.sandkasten-nix-profile"

if [ ! -e "$NIX_TOOLS_PROFILE" ]; then
    echo "Nix tools profile not found: $NIX_TOOLS_PROFILE" >&2
    echo "Build it with: nix build '$SCRIPT_DIR#sandbox-tools' -o '$NIX_TOOLS_PROFILE'" >&2
    exit 1
fi

if ! command -v nix-store >/dev/null 2>&1; then
    echo "nix-store is required to determine the sandbox tools closure" >&2
    exit 1
fi

NIX_TOOLS_STORE_PATH=$(realpath "$NIX_TOOLS_PROFILE")
if ! NIX_CLOSURE=$(nix-store --query --requisites "$NIX_TOOLS_STORE_PATH"); then
    echo "Failed to determine the Nix closure for: $NIX_TOOLS_PROFILE" >&2
    exit 1
fi

NIX_BINDS=(--dir /nix --dir /nix/store --dir /opt)
declare -A NIX_CLOSURE_HASHES=()
while IFS= read -r store_path; do
    if [ -n "$store_path" ]; then
        NIX_BINDS+=(--ro-bind "$store_path" "$store_path")
        store_hash=${store_path#/nix/store/}
        NIX_CLOSURE_HASHES["${store_hash%%-*}"]=1
    fi
done <<< "$NIX_CLOSURE"
NIX_BINDS+=(--ro-bind "$NIX_TOOLS_STORE_PATH" /opt/sandkasten-tools)

## Parse arguments 
WITH_JULIA=true
PROJECT_ROOT=""
while [[ $# -gt 0 ]]; do
    case $1 in
        --no-julia)
            WITH_JULIA=false
            shift
            ;;
        -*)
            echo "Unknown option $1"
            echo "Usage: $0 [--no-julia] [project_directory]"
            exit 1
            ;;
        *)
            PROJECT_ROOT="$1"
            shift
            ;;
    esac
done

## Project directory from argument or current directory
PROJECT_ROOT=$(realpath "${PROJECT_ROOT:-$(pwd)}")
echo "Setting up sandbox for: $PROJECT_ROOT"
mkdir -p "$PROJECT_ROOT" # Ensure the project directory exists

## Create sandbox directory in cache with date and random string
CACHE_DIR="$HOME/.cache/sandkasten"
mkdir -p "$CACHE_DIR"
RANDOM_SUFFIX=$(openssl rand -hex 8)  # 8-character hex string
SANDBOX_HOME="$CACHE_DIR/$(date +%Y-%m-%d)_$RANDOM_SUFFIX"
mkdir -p "$SANDBOX_HOME"
echo "Sandbox home: $SANDBOX_HOME"

## Create the minimal system identity files needed by D-Bus and other tools
if ! command -v dbus-uuidgen >/dev/null 2>&1; then
    echo "dbus-uuidgen is required to create the sandbox machine ID" >&2
    exit 1
fi

SANDBOX_ETC="$SANDBOX_HOME/.sandbox-etc"
mkdir -m 700 "$SANDBOX_ETC"
SANDBOX_UID=$(id -u)
SANDBOX_GID=$(id -g)
printf 'root:x:0:0:root:/root:/usr/sbin/nologin\n' > "$SANDBOX_ETC/passwd"
printf '%s:x:%s:%s:Sandbox User:/home/%s:/usr/bin/fish\n' \
    "$USER" "$SANDBOX_UID" "$SANDBOX_GID" "$USER" >> "$SANDBOX_ETC/passwd"
printf 'nobody:x:65534:65534:Nobody:/:/usr/sbin/nologin\n' >> "$SANDBOX_ETC/passwd"
printf 'root:x:0:\n' > "$SANDBOX_ETC/group"
printf '%s:x:%s:\n' "$USER" "$SANDBOX_GID" >> "$SANDBOX_ETC/group"
printf 'nobody:x:65534:\n' >> "$SANDBOX_ETC/group"
if ! dbus-uuidgen > "$SANDBOX_ETC/machine-id"; then
    echo "Failed to create the sandbox machine ID" >&2
    exit 1
fi
chmod 644 "$SANDBOX_ETC/passwd" "$SANDBOX_ETC/group" "$SANDBOX_ETC/machine-id"
ETC_BINDS=(
    --ro-bind /etc/ssl /etc/ssl
    --ro-bind /etc/pki /etc/pki
    --ro-bind /etc/fonts /etc/fonts
    --ro-bind /etc/resolv.conf /etc/resolv.conf
    --ro-bind /etc/hosts /etc/hosts
    --ro-bind /etc/hostname /etc/hostname
    --ro-bind "$SANDBOX_ETC/passwd" /etc/passwd
    --ro-bind "$SANDBOX_ETC/group" /etc/group
    --ro-bind "$SANDBOX_ETC/machine-id" /etc/machine-id
)

## Create a temp directory (i.e. /tmp) that will persist during the sandbox session
SANDBOX_TEMP="/tmp/sandkasten.tmp.$(date +%Y-%m-%d)_$RANDOM_SUFFIX"
mkdir -p "$SANDBOX_TEMP"
echo "Temp-dir: $SANDBOX_TEMP"

## Set up minimal configuration directories
# Note that configs are copied such that they can be modified, as some are
# Configuration directories
mkdir -p "$SANDBOX_HOME/.config/fish"
mkdir -p "$SANDBOX_HOME/.config/wezterm"
mkdir -p "$SANDBOX_HOME/.config/zathura"
# Local directories
mkdir -p "$SANDBOX_HOME/.local/share/fish"
mkdir -p "$SANDBOX_HOME/.local/bin"
mkdir -p "$SANDBOX_HOME/.cargo/bin"

# Other directories
mkdir -p "$SANDBOX_HOME/julia"

## Copy essential configuration files
# Shell configuration
[ -f "$HOME/.config/fish/config.fish" ] && \
    cp "$HOME/.config/fish/config.fish" "$SANDBOX_HOME/.config/fish/"
# Terminal and editor configs
[ -f "$HOME/.config/wezterm/wezterm.lua" ] && \
    cp "$HOME/.config/wezterm/wezterm.lua" "$SANDBOX_HOME/.config/wezterm/"
[ -f "$HOME/.config/zathura/zathurarc" ] && \
    cp "$HOME/.config/zathura/zathurarc" "$SANDBOX_HOME/.config/zathura/"
# Git configuration
[ -f "$HOME/.gitignore.global" ] && \
    cp "$HOME/.gitignore.global" "$SANDBOX_HOME"
# Scripts and binaries
[ -f "$HOME/.local/bin/juliap" ] && \
    cp "$HOME/.local/bin/juliap" "$SANDBOX_HOME/.local/bin/"
[ -f "$HOME/.local/bin/zathura" ] && \
    cp "$HOME/.local/bin/zathura" "$SANDBOX_HOME/.local/bin/"
[ -f "$HOME/.local/bin/meld" ] && \
    cp "$HOME/.local/bin/meld" "$SANDBOX_HOME/.local/bin/"
[ -f "$HOME/.local/bin/helix-repl-start.sh" ] && \
    cp "$HOME/.local/bin/helix-repl-start.sh" "$SANDBOX_HOME/.local/bin/"
[ -f "$HOME/.local/bin/vale-ls" ] && \
    cp "$HOME/.local/bin/vale-ls" "$SANDBOX_HOME/.local/bin/"
[ -f "$HOME/.cargo/bin/simple-completion-language-server" ] && \
    cp "$HOME/.cargo/bin/simple-completion-language-server" "$SANDBOX_HOME/.cargo/bin/"

## Copy configuration directories
[ -d "$HOME/.config/helix" ] && \
    cp -rL "$HOME/.config/helix" "$SANDBOX_HOME/.config"
[ -d "$HOME/.config/vale" ] && \
    cp -rL "$HOME/.config/vale" "$SANDBOX_HOME/.config"
[ -d "$HOME/.config/opencode" ] && \
    cp -rL "$HOME/.config/opencode" "$SANDBOX_HOME/.config"
[ -d "$HOME/.config/git" ] && \
    cp -rL "$HOME/.config/git" "$SANDBOX_HOME/.config"
# Julia configuration
if [ "$WITH_JULIA" = true ] && [ -d "$HOME/julia/dot-julia-environments" ]; then
    cp -rL "$HOME/julia/dot-julia-environments" "$SANDBOX_HOME/julia/"
fi

## Copied configuration must not depend on unmounted Nix store paths
STORE_REFERENCE_FILES=$(grep -RFl --exclude-dir=.git -- '/nix/store/' "$SANDBOX_HOME" 2>/dev/null)
if [ -n "$STORE_REFERENCE_FILES" ]; then
    UNMOUNTED_STORE_REFERENCES=()
    while IFS= read -r store_reference; do
        store_hash=${store_reference##*/}
        if [ -z "${NIX_CLOSURE_HASHES[$store_hash]+x}" ]; then
            UNMOUNTED_STORE_REFERENCES+=("$store_reference")
        fi
    done < <(grep -RahoE --exclude-dir=.git '/nix/store/[0-9a-z]{32}' "$SANDBOX_HOME" 2>/dev/null | sort -u)

    if [ "${#UNMOUNTED_STORE_REFERENCES[@]}" -gt 0 ]; then
        echo "Copied sandbox files refer to unmounted Nix store paths:" >&2
        printf '  %s\n' "${UNMOUNTED_STORE_REFERENCES[@]}" >&2
        echo "Files containing Nix store references:" >&2
        while IFS= read -r reference_file; do
            printf '  %s\n' "$reference_file" >&2
        done <<< "$STORE_REFERENCE_FILES"
        echo "Replace those references or add their packages to sandbox-tools.nix." >&2
        exit 1
    fi
fi

## Larger directories are copied on write (COW), if possible
COW_BINDS=()
# Julia-related directories (only if requested)
if [ "$WITH_JULIA" = true ]; then
    JULIA_DEPOT_SANDBOX=$(create_cow_snapshot "$HOME/.julia" "$SANDBOX_HOME/.julia")
    COW_BINDS+=(--bind "$JULIA_DEPOT_SANDBOX" "/home/$USER/.julia")
    # Fix up known Nix HM symlinks in Julia depot snapshot
    [ -L "$HOME/.julia/config/startup.jl" ] && \
        cp "$HOME/.julia/config/startup.jl" "$JULIA_DEPOT_SANDBOX/config/startup.jl"
    
    JULIAUP_SANDBOX=$(create_cow_snapshot "$HOME/.juliaup" "$SANDBOX_HOME/.juliaup")
    COW_BINDS+=(--bind "$JULIAUP_SANDBOX" "/home/$USER/.juliaup")
fi
# Tectonic cache
mkdir -p "$SANDBOX_HOME/.cache"
TECTONIC_CACHE_SANDBOX=$(create_cow_snapshot "$HOME/.cache/Tectonic" "$SANDBOX_HOME/.cache/Tectonic")
COW_BINDS+=(--bind "$TECTONIC_CACHE_SANDBOX" "/home/$USER/.cache/Tectonic")

## Patch config
# wezterm.lua to uncomment sandbox-specific settings
if [ -f "$SANDBOX_HOME/.config/wezterm/wezterm.lua" ]; then
  sed -i 's/-- config.use_fancy_tab_bar = false/config.use_fancy_tab_bar = false/' "$SANDBOX_HOME/.config/wezterm/wezterm.lua"
  sed -i 's/-- config.colors.tab_bar = { background = "#9C923C" }/config.colors.tab_bar = { background = "#9C923C" }/' "$SANDBOX_HOME/.config/wezterm/wezterm.lua"
  sed -i "s|-- config.default_prog = { '/usr/bin/fish' }|config.default_prog = { '/usr/bin/fish' }|" "$SANDBOX_HOME/.config/wezterm/wezterm.lua"
fi
# Create sandbox-specific fish configuration
cat > "$SANDBOX_HOME/.config/fish/sandbox.fish" <<EOF
# Sandbox-specific Fish configuration
function fish_prompt
    set_color yellow
    echo -n "[SANDBOX] "
    set_color cyan
    echo -n (prompt_pwd)
    set_color normal
    echo -n "> "
end

set -x EDITOR hx
set -x OPENAI_API_KEY "$OPENAI_API_KEY"
set -x ANTHROPIC_API_KEY "$ANTHROPIC_API_KEY"

# Graphics configuration for Julia
set -x LIBGL_ALWAYS_SOFTWARE "1"

# Welcome message
echo "🔒 Sandboxed Environment: $PROJECT_ROOT 🔒"
EOF
# Append sandbox config to config.fish# 
echo "source ~/.config/fish/sandbox.fish" >> "$SANDBOX_HOME/.config/fish/config.fish"

## Display server configuration
# Wayland
DISPLAY_BINDS=(--ro-bind "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY")

## Add DRI access permissions for GPU
GPU_BINDS=()
for dev in /dev/dri/renderD* /dev/dri/card*; do
  if [ -e "$dev" ]; then
    echo "Binding DRI device: $dev"
    GPU_BINDS+=(--dev-bind "$dev" "$dev")
  fi
done

## Use only explicitly exposed tools and Fedora system paths
SANDBOX_PATH="/opt/sandkasten-tools/bin:/home/$USER/.local/bin:/home/$USER/.cargo/bin"
if [ "$WITH_JULIA" = true ]; then
    SANDBOX_PATH="$SANDBOX_PATH:/home/$USER/.juliaup/bin"
fi
SANDBOX_PATH="$SANDBOX_PATH:/usr/local/bin:/usr/bin:/bin"

## Ensure real opencode data directory exists (needed for bind-mount)
mkdir -p "$HOME/.local/share/opencode"

## Launch sandbox
echo "Launching sandboxed WezTerm..."

# Device access strategy: blacklist approach
# We use --dev to get proper devtmpfs with all infrastructure (symlinks, PTY support, etc.),
# then use --tmpfs to hide unwanted device categories. See create_cow_snapshot comment for details.
# To debug missing device access: strace -f -e trace=openat ./sandkasten 2>&1 | grep -E "/dev.*ENOENT"
bwrap --unshare-user-try \
      --unshare-pid \
      --unshare-uts \
      --unshare-cgroup \
      `# === Read-only system bindings ===` \
      --ro-bind /usr /usr \
      --ro-bind /bin /bin \
      --ro-bind /lib /lib \
      --ro-bind /lib64 /lib64 \
      --ro-bind /usr/libexec /usr/libexec \
      `# === System resources ===` \
      --ro-bind /usr/share/zoneinfo /usr/share/zoneinfo \
      --ro-bind /usr/share/fonts /usr/share/fonts \
      `# === Read-only /etc resources and sandbox identity ===` \
      "${ETC_BINDS[@]}" \
      `# === Nix tools and their read-only runtime closure ===` \
      "${NIX_BINDS[@]}" \
      --share-net \
      `# === Device access (blacklist approach) ===` \
      `# Use --dev for proper devtmpfs, then hide unwanted categories with --tmpfs` \
      --dev /dev \
      `# Hide audio/video/USB devices` \
      --tmpfs /dev/snd \
      --tmpfs /dev/input \
      --tmpfs /dev/usb \
      --tmpfs /dev/disk \
      --tmpfs /dev/block \
      --tmpfs /dev/mapper \
      --tmpfs /dev/net \
      --tmpfs /dev/v4l \
      --tmpfs /dev/hidraw0 \
      --tmpfs /dev/hidraw1 \
      --tmpfs /dev/media0 \
      --tmpfs /dev/media1 \
      --tmpfs /dev/video0 \
      --tmpfs /dev/video1 \
      --tmpfs /dev/video2 \
      --tmpfs /dev/video3 \
      `# Hide system hardware access` \
      --tmpfs /dev/watchdog \
      --tmpfs /dev/watchdog0 \
      --tmpfs /dev/rfkill \
      --tmpfs /dev/snapshot \
      `# Hide virtualization devices` \
      --tmpfs /dev/vboxdrv \
      --tmpfs /dev/vboxdrvu \
      --tmpfs /dev/vboxnetctl \
      --tmpfs /dev/vboxusb \
      --tmpfs /dev/vfio \
      `# === GPU access (whitelisted DRI devices) ===` \
      "${GPU_BINDS[@]}" \
      `# === Sandbox directories ===` \
      --bind "$SANDBOX_TEMP" /tmp \
      --proc /proc \
      --bind "$SANDBOX_HOME" "/home/$USER" \
      `# === Preserved real directories (bind-mounted from host) ===` \
      --bind "$HOME/.local/share/opencode" "/home/$USER/.local/share/opencode" \
      `# === Display server (Wayland) ===` \
      "${DISPLAY_BINDS[@]}" \
      `# === COW snapshots (Julia, Tectonic, etc.) ===` \
      "${COW_BINDS[@]}" \
      `# === Project directory ===` \
      --bind "$PROJECT_ROOT" "$PROJECT_ROOT" \
      `# === Environment variables ===` \
      --setenv HOME "/home/$USER" \
      --setenv WAYLAND_DISPLAY "$WAYLAND_DISPLAY" \
      --setenv XDG_RUNTIME_DIR "$XDG_RUNTIME_DIR" \
      --setenv PATH "$SANDBOX_PATH" \
      --setenv OPENAI_API_KEY "$OPENAI_API_KEY" \
      --setenv OPENAI_API_BASE "$OPENAI_API_BASE" \
      --setenv ANTHROPIC_API_KEY "$ANTHROPIC_API_KEY" \
      --setenv TMPDIR "/tmp" \
      `# === Launch WezTerm with D-Bus confined inside the sandbox ===` \
      /usr/bin/dbus-run-session -- /usr/bin/wezterm start --cwd "$PROJECT_ROOT"

# Capture the exit code
BWRAP_EXIT=$?
echo "bwrap exited with code: $BWRAP_EXIT"

## Clean up
read -p "Delete sandbox directory $SANDBOX_HOME and temp $SANDBOX_TEMP? (y/N)" -n 1 -r
echo    # move to a new line
if [[ $REPLY =~ ^[Yy]$ ]]; then
   # Try to delete BTRFS subvolumes first for faster cleanup
   for subvol in "$JULIA_DEPOT_SANDBOX" "$JULIAUP_SANDBOX" "$TECTONIC_CACHE_SANDBOX"; do
       if [ -d "$subvol" ]; then
           echo "Trying to delete BTRFS subvolume: $subvol"
           if btrfs -q subvolume delete "$subvol" 2>/dev/null; then
               echo "Successfully deleted subvolume: $subvol"
           fi
       fi
   done
   
   # Remove the entire sandbox directory (handles any remaining files/dirs)
   rm -rf "$SANDBOX_HOME"
   rm -rf "$SANDBOX_TEMP"
fi
