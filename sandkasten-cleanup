#!/usr/bin/env python3
"""Remove retained Sandkasten homes and their matching temporary directories."""

import importlib.machinery
import importlib.util
import os
import re
import sys
from pathlib import Path

# Load the extensionless headless launcher for its shared remove_sandbox_home().
SCRIPT_DIR = Path(__file__).resolve().parent
loader = importlib.machinery.SourceFileLoader("sandkasten_headless", str(SCRIPT_DIR / "sandkasten"))
spec = importlib.util.spec_from_loader(loader.name, loader)
headless = importlib.util.module_from_spec(spec)
loader.exec_module(headless)

NAME_RE = re.compile(r"^(?:[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9a-f]{16}|project-[0-9a-f]{12}|project-[0-9a-f]{8})$")


def remove_sandbox(requested: str, cache: Path) -> bool:
    """Remove a retained sandbox home and its matching temporary directory.

    Accept a full path or a name relative to the resolved cache directory.
    Return False for missing or unsafe paths and True after successful cleanup.
    Try BTRFS subvolume deletion before ordinary removal; propagate filesystem
    errors. Refuse homes locked by either launcher. Archived launchers do not
    use this lock, so the caller must ensure their sessions have ended.
    """
    raw = Path(requested)
    candidate = raw if raw.is_absolute() else cache / raw
    if ".." in raw.parts or candidate.is_symlink():
        print(f"Refusing unsafe sandbox path: {requested}", file=sys.stderr)
        return False
    if not candidate.is_dir():
        print(f"Directory does not exist: {candidate}", file=sys.stderr)
        return False
    sandbox = candidate.resolve()
    if sandbox.parent != cache or not NAME_RE.fullmatch(sandbox.name):
        print(f"Refusing path outside the Sandkasten cache or with an invalid name: {requested}",
              file=sys.stderr)
        return False

    # The launchers' own lock, so a running session is always seen.
    try:
        with headless.lock_sandbox_home(sandbox):
            headless.remove_sandbox_home(sandbox)
    except headless.SandboxInUse:
        print(f"Sandbox is still running: {sandbox}", file=sys.stderr)
        return False
    return True


def main(argv: list[str]) -> int:
    """Clean the requested sandbox homes, or all cached homes if argv is empty.

    Return 1 if any requested home is rejected, otherwise 0. Filesystem errors
    propagate rather than being converted into an exit status.
    """
    home = Path(os.environ.get("HOME", str(Path.home())))
    cache = home / ".cache/sandkasten"
    if not cache.is_dir():
        print(f"No sandkasten cache directory found at {cache}")
        return 0
    cache = cache.resolve()
    if argv:
        failed = False
        for requested in argv:
            failed |= not remove_sandbox(requested, cache)
        return 1 if failed else 0

    print(f"Cleaning all Sandkasten directories in {cache}")
    entries = list(cache.iterdir())
    if not entries:
        print("No directories found to clean")
        return 0
    failed = False
    for entry in entries:
        if entry.is_dir() and not entry.is_symlink():
            failed |= not remove_sandbox(str(entry), cache)
    print("All Sandkasten directories cleaned")
    return 1 if failed else 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
