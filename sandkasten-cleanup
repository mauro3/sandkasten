#!/bin/bash
#
# Clean up sandkasten directories and their BTRFS subvolumes
# Usage: sandkasten-cleanup [dir1] [dir2] ...
# If no directories specified, cleans all directories in ~/.cache/sandkasten/

CACHE_DIR="$HOME/.cache/sandkasten"

if [ ! -d "$CACHE_DIR" ]; then
    echo "No sandkasten cache directory found at $CACHE_DIR"
    exit 0
fi

# Function to clean up a single sandbox directory
cleanup_sandbox_dir() {
    local sandbox_dir="$1"
    
    if [ ! -d "$sandbox_dir" ]; then
        echo "Directory does not exist: $sandbox_dir"
        return 1
    fi
    
    echo "Cleaning up: $sandbox_dir"
    
    # Try to delete BTRFS subvolumes first
    local found_subvolumes=false
    for subvol in "$sandbox_dir"/.julia "$sandbox_dir"/.juliaup "$sandbox_dir/.cache/Tectonic" "$sandbox_dir/.local/share/flatpak"; do
        if [ -d "$subvol" ]; then
            echo "  Trying to delete BTRFS subvolume: $subvol"
            if btrfs subvolume delete "$subvol" 2>/dev/null; then
                echo "  Successfully deleted subvolume: $subvol"
                found_subvolumes=true
            fi
        fi
    done
    
    # Clean up corresponding temp directory
    local sandbox_basename=$(basename "$sandbox_dir")
    local temp_dir="/tmp/sandkasten.tmp.$sandbox_basename"
    if [ -d "$temp_dir" ]; then
        echo "  Removing temp directory: $temp_dir"
        rm -rf "$temp_dir"
    fi
    
    # Remove the entire directory
    echo "  Removing directory: $sandbox_dir"
    rm -rf "$sandbox_dir"
    
    if [ "$found_subvolumes" = true ]; then
        echo "  ✓ Cleaned up with subvolume deletion"
    else
        echo "  ✓ Cleaned up (no subvolumes found)"
    fi
}

# If arguments provided, clean only those directories
if [ $# -gt 0 ]; then
    for dir in "$@"; do
        # Handle both absolute paths and relative names
        if [[ "$dir" = /* ]]; then
            cleanup_sandbox_dir "$dir"
        else
            cleanup_sandbox_dir "$CACHE_DIR/$dir"
        fi
    done
else
    # Clean all directories in cache
    echo "Cleaning all sandkasten directories in $CACHE_DIR"
    
    if [ -z "$(ls -A "$CACHE_DIR" 2>/dev/null)" ]; then
        echo "No directories found to clean"
        exit 0
    fi
    
    for sandbox_dir in "$CACHE_DIR"/*; do
        if [ -d "$sandbox_dir" ]; then
            cleanup_sandbox_dir "$sandbox_dir"
        fi
    done
    
    echo "All sandkasten directories cleaned"
fi
